# EvoSynth environment configuration template
# 复制为项目根目录的 .env 后填写。脚本会自动读取 .env。
# 命令行参数优先于环境变量。

# ─── capability_split：从任务样本生成 capabilities.json ───────────────────
CAPABILITY_SPLIT_BASE_URL=
CAPABILITY_SPLIT_MODEL=
CAPABILITY_SPLIT_API_KEY=
CAPABILITY_SPLIT_API_KEY_FILE=

# ─── task_gen：任务生成 ────────────────────────────────────────────────────
# Agent 负责任务研究与生成；key 使用文件路径。
LLMROUTER_BASE_URL=
SYNTHESIS_MODEL=
EVOSYNTH_AGENT_API_KEY_FILE=

# World model 使用独立的 endpoint、模型和 key。
EVOSYNTH_WORLD_MODEL_URL=
EVOSYNTH_WORLD_MODEL=
EVOSYNTH_WORLD_MODEL_API_KEY_FILE=

# ─── rollout：教师模型 ─────────────────────────────────────────────────────
# rollout 使用独立模型，但可与 task_gen 共用 endpoint 和 key 文件。
INFER_MODEL=

# ─── feedback：失败诊断与课程调整 ─────────────────────────────────────────
JUDGE_BASE_URL=
JUDGE_MODEL=
FEEDBACK_API_KEY_FILE=

# ─── 项目数据与输出 ────────────────────────────────────────────────────────
# 以下路径已有项目内默认值，只有换位置时才需要填写。
EVOSYNTH_PERSONA_FILE=
EVOSYNTH_WORLD_POOL_SOURCES=
EVOSYNTH_OUTPUT_ROOT=

# ─── 可选功能 ──────────────────────────────────────────────────────────────
# feedback 生成 curriculum.json 后，指向它即可影响下一轮任务采样。
CURRICULUM_JSON=
